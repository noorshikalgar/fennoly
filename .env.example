# Copy to .env for local development.
FENNOLY_DATABASE_URL=postgres://fennoly:fennoly@localhost:54329/fennoly
# Use an absolute path if you start the server from another folder.
FENNOLY_DATA_DIR=./data
FENNOLY_BIND=127.0.0.1:8686
# Serve the built web app (after `pnpm --dir web build`):
# FENNOLY_WEB_DIR=./web/build
FENNOLY_SECURE_COOKIES=false
FENNOLY_MAX_UPLOAD_GB=50
FENNOLY_TRASH_DAYS=30
RUST_LOG=fennoly=debug,tower_http=info
